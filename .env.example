# Set these in the process environment; no dotenv loader is required.
HOST=127.0.0.1
PORT=8787
SIM_DATA_DIR=.runtime/tasks
SIM_CONCURRENCY=2
SIM_TASK_TIMEOUT_MS=900000
SIM_WORKER_MEMORY_MB=1024
SIM_MAX_TASKS=200
SIM_MAX_BATCH_JOBS=2000
SIM_MAX_REQUESTS=100000
SIM_RETENTION_MS=86400000
# For non-loopback binding, configure a private key of at least 24 characters.
# SIM_ACCESS_TOKEN=
# PUBLIC_ORIGIN=https://your-domain.example
# COOKIE_SECURE=true
